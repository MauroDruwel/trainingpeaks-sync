# ==============================================================================
# Strava to TrainingPeaks Configuration (Mauro Edition)
# Copy this file to .env and adjust values for your setup.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Strava API & OAuth Settings (Required for API access)
# ------------------------------------------------------------------------------
# Create an application at: https://www.strava.com/settings/api
STRAVA_CLIENT_ID=your_client_id_here
STRAVA_CLIENT_SECRET=your_client_secret_here
STRAVA_REDIRECT_URI=http://localhost:8089/callback
STRAVA_TOKEN_FILE=.strava_tokens.json

# (Optional) For 100% headless cron jobs without any browser prompt:
# Once authorized, you can place your athlete's refresh_token here.
# STRAVA_REFRESH_TOKEN=your_refresh_token_here

# ------------------------------------------------------------------------------
# 2. AI Training Analysis (OpenAI or ANY OpenAI-Compatible Provider)
# ------------------------------------------------------------------------------
AI_ENABLED=true
AI_LANGUAGE=English
AI_TEMPERATURE=0.3

# --- Option A: Local Ollama (No API Key needed) ---
# AI_BASE_URL=http://localhost:11434/v1
# AI_MODEL=llama3.2
# AI_API_KEY=ollama

# --- Option B: Local LM Studio ---
# AI_BASE_URL=http://localhost:1234/v1
# AI_MODEL=local-model
# AI_API_KEY=lm-studio

# --- Option C: OpenRouter / Groq / DeepSeek / vLLM ---
# AI_BASE_URL=https://openrouter.ai/api/v1
# AI_API_KEY=sk-or-v1-...
# AI_MODEL=meta-llama/llama-3.2-3b-instruct

# --- Option D: Official OpenAI ---
OPENAI_API_KEY=your_openai_key_here
AI_MODEL=gpt-4o-mini

# Speech synthesis (TTS audio summary)
AI_TTS_ENABLED=false
AI_TTS_MODEL=gpt-4o-mini-tts
AI_TTS_VOICE=alloy

# ------------------------------------------------------------------------------
# 3. Automated Sync & Cronjob Settings
# ------------------------------------------------------------------------------
# Output directory where formatted TCX and AI reports will be saved
SYNC_OUTPUT_DIR=./synced_activities

# State file tracking already-synced activity IDs (ensures idempotency)
SYNC_STATE_FILE=.sync_state.json

# Number of recent activities to inspect per sync pass
SYNC_LIMIT=10

# Daemon sync interval in seconds (e.g. 3600 = every 1 hour)
SYNC_INTERVAL=3600

# Automatically run AI analysis on new activities during sync
SYNC_AUTO_ANALYZE=true
SYNC_SAVE_ANALYSIS=true

# (Optional) Filter by sport: Run, Bike, Swim, or leave empty for all
# SYNC_SPORT_FILTER=Run

# ------------------------------------------------------------------------------
# 4. Optional: Direct Email Upload to TrainingPeaks
# ------------------------------------------------------------------------------
# TrainingPeaks provides every athlete with an upload email address
# (e.g. username.upload@trainingpeaks.com). Files sent here auto-import!
# TP_EMAIL=your_username.upload@trainingpeaks.com
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_email@gmail.com
# SMTP_PASSWORD=your_app_password
# SMTP_FROM=your_email@gmail.com
