# ==============================================================================
# TrainingPeaks Multi-Source Sync Configuration (Mauro Edition)
# Copy this file to .env and adjust values for your setup.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Strava Telemetry (Source 1: Watch / GPS / Heart Rate Telemetry)
# ------------------------------------------------------------------------------
# Create an application at: https://www.strava.com/settings/api
STRAVA_CLIENT_ID=your_client_id_here
STRAVA_CLIENT_SECRET=your_client_secret_here
STRAVA_REDIRECT_URI=http://localhost:8089/callback
STRAVA_TOKEN_FILE=.strava_tokens.json

# (Optional) For 100% headless cron jobs without any browser prompt:
# Once authorized, you can place your athlete's refresh_token here.
# STRAVA_REFRESH_TOKEN=your_refresh_token_here

# ------------------------------------------------------------------------------
# 2. LAGO Swimming Reservations (Source 2: Email Confirmation via IMAP)
# ------------------------------------------------------------------------------
# Confirmation emails arrive at swimming@maurodruwel.be and can be accessed
# via your sports mailbox sports@maurodruwel.be
LAGO_ENABLED=true
LAGO_IMAP_SERVER=mail.maurodruwel.be
LAGO_IMAP_PORT=993
LAGO_IMAP_USER=sports@maurodruwel.be
LAGO_IMAP_PASSWORD=your_email_password_or_app_token_here
LAGO_TARGET_EMAIL=swimming@maurodruwel.be
LAGO_MAILBOX=INBOX

# (Optional) Offline sample directory for testing or local EML file ingestion
# LAGO_SAMPLE_DIR=./sample_emails

# ------------------------------------------------------------------------------
# 3. StudentApp Pool Bookings (Source 3: HAR Export or Sports API)
# ------------------------------------------------------------------------------
STUDENTAPP_ENABLED=true

# Option A: Path to an exported .har file from your browser/app network tab
STUDENTAPP_HAR_PATH=./studentapp_session.har

# Option B: Live API endpoint & token (if querying sports portal directly)
# STUDENTAPP_API_URL=https://sports.university.be/api/v1/user/reservations
# STUDENTAPP_TOKEN=your_bearer_token_here

# ------------------------------------------------------------------------------
# 4. Multi-Source Reconciliation & Watch-Forgotten Support
# ------------------------------------------------------------------------------
# Max time window in minutes to correlate watch workouts with pool bookings
FUSION_TIME_WINDOW_MINUTES=90

# If you went swimming and forgot your watch, automatically generate a valid
# TrainingPeaks workout based on your verified LAGO / StudentApp reservation!
FUSION_AUTO_SYNTHETIC=true
SWIM_DEFAULT_DISTANCE_METERS=2000
SWIM_DEFAULT_DURATION_MINUTES=105

# ------------------------------------------------------------------------------
# 5. AI Training Coach (NVIDIA NIM via NIMStats / OpenAI-Compatible)
# ------------------------------------------------------------------------------
AI_ENABLED=true
AI_LANGUAGE=English
AI_TEMPERATURE=0.3

# --- Option A: NVIDIA NIM + NIMStats (Flagship, Recommended!) ---
# Queries Mauro's NIMStats API (https://nimstats.maurodruwel.be/) to automatically
# select the #1 benchmarked model, then executes completions on NVIDIA NIM!
AI_PROVIDER=nvidia
NVIDIA_API_KEY=your_nvidia_api_key_here
NIMSTATS_ENABLED=true
NIMSTATS_STRATEGY=intelligence   # "intelligence" (best coach), "balanced", or "speed"
NIMSTATS_URL=https://nimstats.maurodruwel.be
# AI_MODEL=auto                   # "auto" queries NIMStats live, or specify exact model

# --- Option B: Local Ollama (No API Key needed) ---
# AI_BASE_URL=http://localhost:11434/v1
# AI_MODEL=llama3.2
# AI_API_KEY=ollama

# --- Option C: Local LM Studio ---
# AI_BASE_URL=http://localhost:1234/v1
# AI_MODEL=local-model
# AI_API_KEY=lm-studio

# --- Option D: OpenRouter / Groq / DeepSeek / vLLM ---
# AI_BASE_URL=https://openrouter.ai/api/v1
# AI_API_KEY=sk-or-v1-...
# AI_MODEL=meta-llama/llama-3.2-3b-instruct

# --- Option E: Official OpenAI ---
# OPENAI_API_KEY=your_openai_key_here
# AI_MODEL=gpt-4o-mini

# Speech synthesis (TTS audio summary)
AI_TTS_ENABLED=false
AI_TTS_MODEL=gpt-4o-mini-tts
AI_TTS_VOICE=alloy

# ------------------------------------------------------------------------------
# 6. Automated Sync & Cronjob Settings
# ------------------------------------------------------------------------------
# Output directory where formatted TCX and AI reports will be saved
SYNC_OUTPUT_DIR=./synced_activities

# State file tracking already-synced activity IDs (ensures idempotency)
SYNC_STATE_FILE=.sync_state.json

# Number of recent activities to inspect per sync pass
SYNC_LIMIT=10

# Daemon sync interval in seconds (e.g. 3600 = every 1 hour)
SYNC_INTERVAL=3600

# Automatically run AI analysis on new activities during sync
SYNC_AUTO_ANALYZE=true
SYNC_SAVE_ANALYSIS=true

# (Optional) Filter by sport: Run, Bike, Swim, or leave empty for all
# SYNC_SPORT_FILTER=Swim

# ------------------------------------------------------------------------------
# 7. Optional: Direct Email Upload to TrainingPeaks
# ------------------------------------------------------------------------------
# TrainingPeaks provides every athlete with an upload email address
# (e.g. username.upload@trainingpeaks.com). Files sent here auto-import!
# TP_EMAIL=your_username.upload@trainingpeaks.com
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_email@gmail.com
# SMTP_PASSWORD=your_app_password
# SMTP_FROM=your_email@gmail.com
